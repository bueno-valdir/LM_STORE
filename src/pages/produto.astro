---
/**
 * Pagina de detalhe do produto.
 * Le o produto do painel (PocketBase) pelo navegador, a partir do ?id= da URL.
 * Ex.: /produto?id=vpx9rjpdmkfomk2
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout titulo="Produto" descricao="Detalhes do produto na Lojinha da Miih.">
  <article class="container-loja py-8">
    <nav class="mb-4 text-sm text-texto-suave" aria-label="Você está em">
      <a href={withBase('/catalogo')} class="hover:text-marca">Catálogo</a>
      <span aria-hidden="true"> / </span>
      <span id="trilha-nome" class="text-texto">Produto</span>
    </nav>

    <div id="detalhe"></div>

    <p id="carregando" class="py-10 text-center text-texto-suave">Carregando produto...</p>
    <p id="nao-encontrado" class="hidden py-10 text-center text-texto-suave">
      Produto não encontrado. <a class="text-marca-escuro hover:underline" href={withBase('/catalogo')}>Voltar ao catálogo</a>.
    </p>
  </article>
</BaseLayout>

<script>
  import {
    carregarProduto,
    precoVigente,
    formatarPreco,
    rotuloCategoria,
    linkWhatsApp,
    textoSimples,
    esc,
    type ProdutoView,
  } from '../lib/clienteProdutos';

  const detalhe = document.getElementById('detalhe')!;
  const carregando = document.getElementById('carregando');
  const naoEncontrado = document.getElementById('nao-encontrado');
  const trilhaNome = document.getElementById('trilha-nome');

  function render(p: ProdutoView) {
    const { atual, de, promo } = precoVigente(p);
    const atualFmt = formatarPreco(atual);
    const deFmt = formatarPreco(de);
    const esgotado = !p.disponivel;
    const capa = p.imagens[0];

    if (trilhaNome) trilhaNome.textContent = p.nome;
    document.title = `${p.nome} | Lojinha da Miih`;

    const miniaturas =
      p.imagens.length > 1
        ? `<div class="mt-3 grid grid-cols-4 gap-2">${p.imagens
            .map(
              (img, i) =>
                `<button type="button" class="miniatura overflow-hidden rounded-lg border border-fundo-borda bg-fundo-claro focus-visible:border-marca" data-src="${esc(img.src)}" data-alt="${esc(img.alt)}" aria-label="Ver imagem ${i + 1}"><img src="${esc(img.src)}" alt="${esc(img.alt)}" width="160" height="160" loading="lazy" decoding="async" class="aspect-square w-full object-cover" /></button>`,
            )
            .join('')}</div>`
        : '';

    const precoBloco = atualFmt
      ? `<div class="flex items-baseline gap-3">
           <span class="font-titulo text-3xl font-bold text-marca">${atualFmt}</span>
           ${promo && deFmt ? `<span class="text-lg text-texto-suave line-through">${deFmt}</span>` : ''}
         </div>`
      : '<span class="text-lg font-medium text-texto-suave">Consulte o valor no WhatsApp</span>';

    // Atributos: so aparecem quando preenchidos (vazio ou zero nao mostra).
    const positivo = (n: number | null): n is number => typeof n === 'number' && n > 0;
    const dimensoes =
      positivo(p.alturaCm) && positivo(p.larguraCm) && positivo(p.comprimentoCm)
        ? `${p.alturaCm} × ${p.larguraCm} × ${p.comprimentoCm} cm`
        : '';
    const linhaAtributo = (rotulo: string, valor: string) =>
      valor
        ? `<div class="flex gap-2"><dt class="font-semibold text-texto">${rotulo}:</dt><dd>${esc(valor)}</dd></div>`
        : '';
    const atributos = [
      linhaAtributo('Volume', p.volume ?? ''),
      linhaAtributo('Peso', positivo(p.pesoG) ? `${p.pesoG} g` : ''),
      linhaAtributo('Dimensões', dimensoes),
    ].join('');

    // Seletor de tom: aparece so quando o produto tem 1 ou mais tons.
    // Tons sem estoque ficam desabilitados; comeca no primeiro tom disponivel.
    const tomDisponivel = (n: number) => !p.estoqueTons || (p.estoqueTons[n - 1] ?? 0) > 0;
    const tonsLista = Array.from({ length: p.tons }, (_, i) => i + 1);
    const primeiroTom = tonsLista.find(tomDisponivel) ?? 1;
    const tomBloco =
      p.tons >= 1
        ? `<div class="mt-5">
             <label for="tom-select" class="block text-sm font-semibold text-texto">Escolha o tom</label>
             <select id="tom-select" class="mt-1 w-full max-w-xs rounded-marca border border-fundo-borda bg-fundo px-3 py-2 text-sm text-texto focus-visible:border-marca">
               ${tonsLista
                 .map((n) => {
                   const ok = tomDisponivel(n);
                   return `<option value="${n}"${n === primeiroTom ? ' selected' : ''}${ok ? '' : ' disabled'}>Tom ${n}${ok ? '' : ' (esgotado)'}</option>`;
                 })
                 .join('')}
             </select>
           </div>`
        : '';

    detalhe.innerHTML = `
      <div class="grid gap-8 md:grid-cols-2">
        <section>
          <div class="overflow-hidden rounded-marca border border-fundo-borda bg-fundo-claro">
            <img id="imagem-principal" src="${esc(capa.src)}" alt="${esc(capa.alt)}" width="800" height="800" loading="eager" decoding="async" class="aspect-square w-full object-cover" />
          </div>
          ${miniaturas}
        </section>

        <section>
          <span class="text-xs uppercase tracking-wide text-texto-suave">${esc(p.marca)} &middot; ${esc(rotuloCategoria(p.categoria))}</span>
          <h1 class="mt-1 font-titulo text-3xl font-bold text-texto">${esc(p.nome)}</h1>

          <div class="mt-3 flex flex-wrap gap-2">
            ${promo ? '<span class="etiqueta bg-marca text-white">Promoção</span>' : ''}
            <span class="etiqueta ${esgotado ? 'bg-fundo-claro text-texto-suave' : 'bg-marca/10 text-marca-escuro'}">${esgotado ? 'Esgotado' : 'Em estoque'}</span>
          </div>

          <div class="mt-5">${precoBloco}</div>

          ${atributos ? `<dl class="mt-4 space-y-1 text-sm text-texto-suave">${atributos}</dl>` : ''}

          ${tomBloco}

          <p class="mt-5 whitespace-pre-line leading-relaxed text-texto-suave">${esc(textoSimples(p.descricao))}</p>

          <div class="mt-6">
            <a id="btn-wpp" href="${esc(linkWhatsApp(p, p.tons >= 1 ? primeiroTom : undefined))}" target="_blank" rel="noopener" class="btn-marca">
              ${esgotado ? 'Avise-me / Pedir mesmo assim' : 'Pedir no WhatsApp'}
            </a>
            <p class="mt-2 text-xs text-texto-suave">Você será levada ao WhatsApp com a mensagem do produto já preenchida.</p>
          </div>
        </section>
      </div>`;

    // Ao trocar o tom, atualiza a mensagem do WhatsApp com o tom escolhido.
    const tomSelect = document.getElementById('tom-select') as HTMLSelectElement | null;
    const btnWpp = document.getElementById('btn-wpp') as HTMLAnchorElement | null;
    if (tomSelect && btnWpp) {
      tomSelect.addEventListener('change', () => {
        btnWpp.href = linkWhatsApp(p, Number(tomSelect.value));
      });
    }

    // Troca a imagem principal ao clicar numa miniatura.
    const principal = document.getElementById('imagem-principal') as HTMLImageElement | null;
    detalhe.querySelectorAll<HTMLButtonElement>('.miniatura').forEach((botao) => {
      botao.addEventListener('click', () => {
        if (!principal) return;
        principal.src = botao.dataset.src ?? principal.src;
        principal.alt = botao.dataset.alt ?? principal.alt;
      });
    });
  }

  async function iniciar() {
    const id = new URLSearchParams(location.search).get('id') ?? '';
    try {
      const produto = id ? await carregarProduto(id) : null;
      carregando?.classList.add('hidden');
      if (!produto) {
        naoEncontrado?.classList.remove('hidden');
        return;
      }
      render(produto);
    } catch (e) {
      console.error('[produto] erro ao carregar:', e);
      carregando?.classList.add('hidden');
      naoEncontrado?.classList.remove('hidden');
    }
  }

  iniciar();
</script>
