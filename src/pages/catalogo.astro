---
/**
 * Catalogo: grade de produtos com filtro por categoria e atalho para promocoes.
 * Os produtos sao lidos do painel (PocketBase) pelo navegador, e os filtros
 * sao montados a partir das categorias que existem de verdade nos produtos.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titulo="Catálogo"
  descricao="Veja toda a maquiagem e skincare da Lojinha da Miih e peça pelo WhatsApp."
>
  <section class="container-loja py-10">
    <header class="mb-6">
      <h1 class="font-titulo text-3xl font-bold text-texto">Catálogo</h1>
      <p class="mt-1 text-texto-suave">
        Filtre por categoria ou veja as promoções. Toque no produto para ver os detalhes.
      </p>
    </header>

    <!-- Campo de busca (filtra na hora). -->
    <div class="mb-4">
      <div class="relative max-w-md">
        <input
          id="busca"
          type="search"
          placeholder="Buscar por nome ou marca..."
          aria-label="Buscar produtos"
          class="w-full rounded-full border border-fundo-borda bg-fundo px-4 py-2 pr-10 text-sm text-texto placeholder:text-texto-suave focus-visible:border-marca"
        />
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-texto-suave">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        </span>
      </div>
    </div>

    <!-- Barra de filtros (preenchida pelo navegador). Ancora #promocoes. -->
    <div id="promocoes" class="mb-6 flex flex-wrap gap-2" role="tablist" aria-label="Filtrar produtos"></div>

    <!-- Grade de produtos (preenchida pelo navegador). -->
    <div id="grade" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4"></div>

    <!-- Estados de carregamento / vazio / erro. -->
    <p id="carregando" class="py-10 text-center text-texto-suave">Carregando produtos...</p>
    <p id="vazio" class="hidden py-10 text-center text-texto-suave">
      Nenhum produto por aqui ainda. Volte em breve.
    </p>
    <p id="erro" class="hidden py-10 text-center text-texto-suave">
      Não foi possível carregar os produtos agora. Tente atualizar a página.
    </p>
  </section>
</BaseLayout>

<script>
  import { carregarProdutos, cardHTML, rotuloCategoria, esc, type ProdutoView } from '../lib/clienteProdutos';

  const grade = document.getElementById('grade')!;
  const barra = document.getElementById('promocoes')!;
  const busca = document.getElementById('busca') as HTMLInputElement | null;
  const carregando = document.getElementById('carregando');
  const vazio = document.getElementById('vazio');
  const erro = document.getElementById('erro');

  // Classe dos botoes de filtro (escrita por extenso para o Tailwind incluir).
  const CLASSE_FILTRO =
    'filtro-btn etiqueta border border-fundo-borda bg-fundo-claro text-texto-suave aria-selected:border-marca aria-selected:bg-marca aria-selected:text-white';

  // Le os parametros da URL: ?q=busca e ?cat=categoria.
  const params = new URLSearchParams(location.search);
  let produtos: ProdutoView[] = [];
  let filtroAtual = params.get('cat') || 'todos';
  let termo = (params.get('q') || '').trim().toLowerCase();

  function montarFiltros() {
    const categorias = Array.from(new Set(produtos.map((p) => p.categoria).filter(Boolean)));
    const temPromo = produtos.some((p) => p.promocao);

    const filtros = [
      { valor: 'todos', rotulo: 'Todos' },
      ...categorias.map((c) => ({ valor: c, rotulo: rotuloCategoria(c) })),
      ...(temPromo ? [{ valor: 'promocao', rotulo: 'Promoções' }] : []),
    ];

    // Se o filtro vindo da URL nao existir, volta para "todos".
    if (!filtros.some((f) => f.valor === filtroAtual)) filtroAtual = 'todos';

    barra.innerHTML = filtros
      .map(
        (f) =>
          `<button type="button" class="${CLASSE_FILTRO}" data-filtro="${esc(f.valor)}" role="tab" aria-selected="${f.valor === filtroAtual ? 'true' : 'false'}">${esc(f.rotulo)}</button>`,
      )
      .join('');

    barra.querySelectorAll<HTMLButtonElement>('.filtro-btn').forEach((botao) => {
      botao.addEventListener('click', () => {
        barra.querySelectorAll('.filtro-btn').forEach((b) => b.setAttribute('aria-selected', 'false'));
        botao.setAttribute('aria-selected', 'true');
        filtroAtual = botao.dataset.filtro ?? 'todos';
        renderizar();
      });
    });
  }

  function renderizar() {
    const lista = produtos.filter((p) => {
      // Filtro por categoria/promocao.
      const passaFiltro =
        filtroAtual === 'todos'
          ? true
          : filtroAtual === 'promocao'
            ? p.promocao
            : p.categoria === filtroAtual;
      if (!passaFiltro) return false;

      // Filtro por texto de busca (nome, marca ou categoria).
      if (termo) {
        const alvo = `${p.nome} ${p.marca} ${p.categoria}`.toLowerCase();
        if (!alvo.includes(termo)) return false;
      }
      return true;
    });

    grade.innerHTML = lista.map(cardHTML).join('');
    vazio?.classList.toggle('hidden', lista.length > 0);
  }

  async function iniciar() {
    try {
      produtos = await carregarProdutos();
      carregando?.classList.add('hidden');

      if (!produtos.length) {
        vazio?.classList.remove('hidden');
        return;
      }

      // Se a pagina abrir via #promocoes (e sem ?cat), comeca nas promocoes.
      if (!params.get('cat') && location.hash === '#promocoes' && produtos.some((p) => p.promocao)) {
        filtroAtual = 'promocao';
      }

      montarFiltros();

      // Preenche e liga o campo de busca (filtra ao digitar).
      if (busca) {
        busca.value = termo;
        busca.addEventListener('input', () => {
          termo = busca.value.trim().toLowerCase();
          renderizar();
        });
      }

      renderizar();
    } catch (e) {
      console.error('[catalogo] erro ao carregar produtos:', e);
      carregando?.classList.add('hidden');
      erro?.classList.remove('hidden');
    }
  }

  iniciar();
</script>
