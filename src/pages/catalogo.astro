---
/**
 * Catalogo: grade de produtos com filtro por categoria e atalho para promocoes.
 * Os produtos sao lidos do painel (PocketBase) pelo navegador, e os filtros
 * sao montados a partir das categorias que existem de verdade nos produtos.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titulo="Catalogo"
  descricao="Veja toda a maquiagem e skincare da Lojinha da Miih e peca pelo WhatsApp."
>
  <section class="container-loja py-10">
    <header class="mb-6">
      <h1 class="font-titulo text-3xl font-bold text-texto">Catalogo</h1>
      <p class="mt-1 text-texto-suave">
        Filtre por categoria ou veja as promocoes. Toque no produto para ver os detalhes.
      </p>
    </header>

    <!-- Barra de filtros (preenchida pelo navegador). Ancora #promocoes. -->
    <div id="promocoes" class="mb-6 flex flex-wrap gap-2" role="tablist" aria-label="Filtrar produtos"></div>

    <!-- Grade de produtos (preenchida pelo navegador). -->
    <div id="grade" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4"></div>

    <!-- Estados de carregamento / vazio / erro. -->
    <p id="carregando" class="py-10 text-center text-texto-suave">Carregando produtos...</p>
    <p id="vazio" class="hidden py-10 text-center text-texto-suave">
      Nenhum produto por aqui ainda. Volte em breve.
    </p>
    <p id="erro" class="hidden py-10 text-center text-texto-suave">
      Nao foi possivel carregar os produtos agora. Tente atualizar a pagina.
    </p>
  </section>
</BaseLayout>

<script>
  import { carregarProdutos, cardHTML, rotuloCategoria, esc, type ProdutoView } from '../lib/clienteProdutos';

  const grade = document.getElementById('grade')!;
  const barra = document.getElementById('promocoes')!;
  const carregando = document.getElementById('carregando');
  const vazio = document.getElementById('vazio');
  const erro = document.getElementById('erro');

  // Classe dos botoes de filtro (escrita por extenso para o Tailwind incluir).
  const CLASSE_FILTRO =
    'filtro-btn etiqueta border border-fundo-borda bg-fundo-claro text-texto-suave aria-selected:border-marca aria-selected:bg-marca aria-selected:text-white';

  let produtos: ProdutoView[] = [];
  let filtroAtual = 'todos';

  function montarFiltros() {
    const categorias = Array.from(new Set(produtos.map((p) => p.categoria).filter(Boolean)));
    const temPromo = produtos.some((p) => p.promocao);

    const filtros = [
      { valor: 'todos', rotulo: 'Todos' },
      ...categorias.map((c) => ({ valor: c, rotulo: rotuloCategoria(c) })),
      ...(temPromo ? [{ valor: 'promocao', rotulo: 'Promocoes' }] : []),
    ];

    barra.innerHTML = filtros
      .map(
        (f, i) =>
          `<button type="button" class="${CLASSE_FILTRO}" data-filtro="${esc(f.valor)}" role="tab" aria-selected="${i === 0 ? 'true' : 'false'}">${esc(f.rotulo)}</button>`,
      )
      .join('');

    barra.querySelectorAll<HTMLButtonElement>('.filtro-btn').forEach((botao) => {
      botao.addEventListener('click', () => {
        barra.querySelectorAll('.filtro-btn').forEach((b) => b.setAttribute('aria-selected', 'false'));
        botao.setAttribute('aria-selected', 'true');
        filtroAtual = botao.dataset.filtro ?? 'todos';
        renderizar();
      });
    });
  }

  function renderizar() {
    const lista = produtos.filter((p) => {
      if (filtroAtual === 'todos') return true;
      if (filtroAtual === 'promocao') return p.promocao;
      return p.categoria === filtroAtual;
    });

    grade.innerHTML = lista.map(cardHTML).join('');
    vazio?.classList.toggle('hidden', lista.length > 0);
  }

  async function iniciar() {
    try {
      produtos = await carregarProdutos();
      carregando?.classList.add('hidden');

      if (!produtos.length) {
        vazio?.classList.remove('hidden');
        return;
      }

      montarFiltros();

      // Se a pagina abrir via #promocoes, comeca filtrando promocoes.
      if (location.hash === '#promocoes' && produtos.some((p) => p.promocao)) {
        filtroAtual = 'promocao';
        barra.querySelectorAll('.filtro-btn').forEach((b) => {
          b.setAttribute('aria-selected', b.getAttribute('data-filtro') === 'promocao' ? 'true' : 'false');
        });
      }

      renderizar();
    } catch (e) {
      console.error('[catalogo] erro ao carregar produtos:', e);
      carregando?.classList.add('hidden');
      erro?.classList.remove('hidden');
    }
  }

  iniciar();
</script>
