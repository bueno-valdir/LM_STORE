---
/**
 * Catalogo: grade de produtos com filtros por categoria, subcategoria, marca e
 * promocoes. Os produtos sao lidos do painel (PocketBase) pelo navegador.
 *
 * Filtros via URL:
 *   ?cat=rosto      -> categoria-mae (mostra tambem as subcategorias dela)
 *   ?sub=base       -> subcategoria especifica
 *   ?marca=Eudora   -> por marca
 *   ?q=texto        -> busca por nome/marca
 *   #promocoes      -> abre ja filtrando promocoes
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titulo="Catálogo"
  descricao="Veja toda a maquiagem e skincare da Lojinha da Miih e peça pelo WhatsApp."
>
  <section class="container-loja py-10">
    <header class="mb-6">
      <h1 class="font-titulo text-3xl font-bold text-texto">Catálogo</h1>
      <p class="mt-1 text-texto-suave">
        Filtre por categoria ou veja as promoções. Toque no produto para ver os detalhes.
      </p>
    </header>

    <!-- Campo de busca (filtra na hora). -->
    <div class="mb-4">
      <div class="relative max-w-md">
        <input
          id="busca"
          type="search"
          placeholder="Buscar por nome ou marca..."
          aria-label="Buscar produtos"
          class="w-full rounded-full border border-fundo-borda bg-fundo px-4 py-2 pr-10 text-sm text-texto placeholder:text-texto-suave focus-visible:border-marca"
        />
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-texto-suave">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        </span>
      </div>
    </div>

    <!-- Barra de filtros principais (categorias). Ancora #promocoes. -->
    <div id="promocoes" class="mb-3 flex flex-wrap gap-2" role="tablist" aria-label="Filtrar por categoria"></div>

    <!-- Barra de subcategorias (aparece quando uma categoria esta selecionada). -->
    <div id="subfiltros" class="mb-6 flex flex-wrap gap-2"></div>

    <!-- Grade de produtos (preenchida pelo navegador). -->
    <div id="grade" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4"></div>

    <!-- Estados de carregamento / vazio / erro. -->
    <p id="carregando" class="py-10 text-center text-texto-suave">Carregando produtos...</p>
    <p id="vazio" class="hidden py-10 text-center text-texto-suave">
      Nenhum produto por aqui ainda. Volte em breve.
    </p>
    <p id="erro" class="hidden py-10 text-center text-texto-suave">
      Não foi possível carregar os produtos agora. Tente atualizar a página.
    </p>
  </section>
</BaseLayout>

<script>
  import { carregarProdutos, cardHTML, esc, type ProdutoView } from '../lib/clienteProdutos';
  import { arvoreCategorias, categoriaMaeDe, rotuloDe } from '../config/categorias';

  const grade = document.getElementById('grade')!;
  const barra = document.getElementById('promocoes')!;
  const subBarra = document.getElementById('subfiltros')!;
  const busca = document.getElementById('busca') as HTMLInputElement | null;
  const carregando = document.getElementById('carregando');
  const vazio = document.getElementById('vazio');
  const erro = document.getElementById('erro');

  // Classe dos botoes de filtro (escrita por extenso para o Tailwind incluir).
  const CLASSE_FILTRO =
    'filtro-btn etiqueta border border-fundo-borda bg-fundo-claro text-texto-suave aria-selected:border-marca aria-selected:bg-marca aria-selected:text-white';
  const CLASSE_SUB =
    'sub-btn etiqueta border border-fundo-borda bg-fundo text-texto-suave aria-selected:border-marca aria-selected:bg-marca/10 aria-selected:text-marca-escuro';

  // Le os parametros da URL.
  const params = new URLSearchParams(location.search);
  let produtos: ProdutoView[] = [];
  let filtroCat = params.get('cat') || 'todos'; // categoria-mae, 'todos' ou 'promocao'
  let filtroSub = params.get('sub') || ''; // subcategoria especifica
  let filtroMarca = (params.get('marca') || '').trim();
  let termo = (params.get('q') || '').trim().toLowerCase();

  // Se veio uma subcategoria pela URL, descobre a categoria-mae dela.
  if (filtroSub) {
    const mae = categoriaMaeDe(filtroSub);
    if (mae) filtroCat = mae.slug;
  }

  /** Categorias-mae que realmente tem produtos cadastrados. */
  function categoriasComProdutos(): string[] {
    const presentes = new Set<string>();
    for (const p of produtos) {
      const mae = categoriaMaeDe(p.categoria);
      if (mae) presentes.add(mae.slug);
      else if (p.categoria) presentes.add(p.categoria); // legado/desconhecida
    }
    // Mantem a ordem da arvore; categorias desconhecidas vao para o fim.
    const ordenadas = arvoreCategorias.map((c) => c.slug).filter((s) => presentes.has(s));
    const extras = Array.from(presentes).filter((s) => !ordenadas.includes(s));
    return [...ordenadas, ...extras];
  }

  function montarFiltros() {
    const cats = categoriasComProdutos();
    const temPromo = produtos.some((p) => p.promocao);

    const filtros = [
      { valor: 'todos', rotulo: 'Todos' },
      ...cats.map((c) => ({ valor: c, rotulo: rotuloDe(c) })),
      ...(temPromo ? [{ valor: 'promocao', rotulo: 'Promoções' }] : []),
    ];

    // Se o filtro de categoria vindo da URL nao existir, volta para "todos".
    if (!filtros.some((f) => f.valor === filtroCat)) filtroCat = 'todos';

    barra.innerHTML =
      filtros
        .map(
          (f) =>
            `<button type="button" class="${CLASSE_FILTRO}" data-cat="${esc(f.valor)}" role="tab" aria-selected="${f.valor === filtroCat ? 'true' : 'false'}">${esc(f.rotulo)}</button>`,
        )
        .join('') +
      (filtroMarca
        ? `<button type="button" id="limpar-marca" class="etiqueta border border-marca bg-marca/10 text-marca-escuro">Marca: ${esc(filtroMarca)} ✕</button>`
        : '');

    barra.querySelectorAll<HTMLButtonElement>('.filtro-btn').forEach((botao) => {
      botao.addEventListener('click', () => {
        filtroCat = botao.dataset.cat ?? 'todos';
        filtroSub = ''; // troca de categoria zera a subcategoria
        montarFiltros();
        renderizar();
      });
    });

    const limparMarca = document.getElementById('limpar-marca');
    limparMarca?.addEventListener('click', () => {
      filtroMarca = '';
      montarFiltros();
      renderizar();
    });

    montarSubFiltros();
  }

  function montarSubFiltros() {
    const cat = arvoreCategorias.find((c) => c.slug === filtroCat);
    // So mostra subcategorias quando uma categoria-mae conhecida esta ativa.
    if (!cat) {
      subBarra.innerHTML = '';
      return;
    }

    // So oferece subcategorias que tem ao menos um produto.
    const subsComProduto = new Set(produtos.map((p) => p.categoria));
    const subs = cat.subs.filter((s) => subsComProduto.has(s.slug));
    if (!subs.length) {
      subBarra.innerHTML = '';
      return;
    }

    const itens = [{ slug: '', rotulo: `Todos de ${cat.rotulo}` }, ...subs];
    subBarra.innerHTML = itens
      .map(
        (s) =>
          `<button type="button" class="${CLASSE_SUB}" data-sub="${esc(s.slug)}" aria-selected="${s.slug === filtroSub ? 'true' : 'false'}">${esc(s.rotulo)}</button>`,
      )
      .join('');

    subBarra.querySelectorAll<HTMLButtonElement>('.sub-btn').forEach((botao) => {
      botao.addEventListener('click', () => {
        filtroSub = botao.dataset.sub ?? '';
        subBarra.querySelectorAll('.sub-btn').forEach((b) => b.setAttribute('aria-selected', 'false'));
        botao.setAttribute('aria-selected', 'true');
        renderizar();
      });
    });
  }

  function renderizar() {
    const lista = produtos.filter((p) => {
      // Marca (independente dos demais filtros).
      if (filtroMarca && (p.marca || '').trim() !== filtroMarca) return false;

      // Subcategoria especifica tem prioridade sobre a categoria-mae.
      if (filtroSub) {
        if (p.categoria !== filtroSub) return false;
      } else if (filtroCat === 'promocao') {
        if (!p.promocao) return false;
      } else if (filtroCat !== 'todos') {
        const mae = categoriaMaeDe(p.categoria);
        const slugMae = mae ? mae.slug : p.categoria;
        if (slugMae !== filtroCat) return false;
      }

      // Busca por texto (nome, marca ou categoria).
      if (termo) {
        const alvo = `${p.nome} ${p.marca} ${rotuloDe(p.categoria)}`.toLowerCase();
        if (!alvo.includes(termo)) return false;
      }
      return true;
    });

    grade.innerHTML = lista.map(cardHTML).join('');
    vazio?.classList.toggle('hidden', lista.length > 0);
  }

  async function iniciar() {
    try {
      produtos = await carregarProdutos();
      carregando?.classList.add('hidden');

      if (!produtos.length) {
        vazio?.classList.remove('hidden');
        return;
      }

      // Se a pagina abrir via #promocoes (e sem ?cat/?sub), comeca nas promocoes.
      if (
        !params.get('cat') &&
        !params.get('sub') &&
        location.hash === '#promocoes' &&
        produtos.some((p) => p.promocao)
      ) {
        filtroCat = 'promocao';
      }

      montarFiltros();

      // Preenche e liga o campo de busca (filtra ao digitar).
      if (busca) {
        busca.value = termo;
        busca.addEventListener('input', () => {
          termo = busca.value.trim().toLowerCase();
          renderizar();
        });
      }

      renderizar();
    } catch (e) {
      console.error('[catalogo] erro ao carregar produtos:', e);
      carregando?.classList.add('hidden');
      erro?.classList.remove('hidden');
    }
  }

  iniciar();
</script>
