---
/**
 * Home: hero em carrossel, selos de confianca, carrosseis de produtos e CTA.
 * Os produtos sao lidos do painel pelo navegador.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Selos from '../components/Selos.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { withBase } from '../lib/url';
---

<BaseLayout>
  <Hero />
  <Selos />

  <!-- FAIXA DE PROMOCAO (mostrada pelo navegador se houver promocoes). -->
  <section id="faixa-promo" class="hidden bg-gradiente-marca">
    <div class="container-loja flex flex-wrap items-center justify-between gap-3 py-4 text-white">
      <p class="font-titulo font-semibold">Promoções da semana com precinho que cabe no bolso</p>
      <a
        href={withBase('/catalogo#promocoes')}
        class="rounded-marca bg-white px-4 py-2 text-sm font-semibold text-preto transition-transform hover:scale-[1.02]"
      >
        Ver promoções
      </a>
    </div>
  </section>

  <!-- CARROSSEIS DE PRODUTOS (preenchidos pelo navegador). -->
  <div id="carrosseis"></div>
  <p id="carrosseis-carregando" class="container-loja py-12 text-center text-texto-suave">Carregando produtos...</p>
  <p id="carrosseis-vazio" class="hidden container-loja py-12 text-center text-texto-suave">
    Em breve, novos produtos por aqui.
  </p>

  <!-- CTA FINAL -->
  <section class="container-loja py-12">
    <div class="rounded-marca border border-fundo-borda bg-fundo-claro p-8 text-center">
      <h2 class="font-titulo text-2xl font-bold text-texto">Ficou com vontade?</h2>
      <p class="mx-auto mt-2 max-w-md text-texto-suave">
        Escolha seus produtos e finalize o pedido pelo WhatsApp, rapidinho e sem complicação.
      </p>
      <div class="mt-5 flex justify-center">
        <WhatsAppButton rotulo="Fazer meu pedido" />
      </div>
    </div>
  </section>

  <script>
    import { carregarProdutos, carrosselHTML } from '../lib/clienteProdutos';
    import { withBase } from '../lib/url';

    const cont = document.getElementById('carrosseis')!;
    const carregando = document.getElementById('carrosseis-carregando');
    const vazio = document.getElementById('carrosseis-vazio');
    const faixa = document.getElementById('faixa-promo');

    carregarProdutos()
      .then((produtos) => {
        carregando?.classList.add('hidden');
        if (!produtos.length) {
          vazio?.classList.remove('hidden');
          return;
        }

        if (faixa && produtos.some((p) => p.promocao)) faixa.classList.remove('hidden');

        const destaques = produtos.filter((p) => p.destaque);
        const promocoes = produtos.filter((p) => p.promocao);

        let html = carrosselHTML(
          'Destaques',
          'Queridinhos selecionados pra você',
          withBase('/catalogo'),
          destaques.length ? destaques : produtos,
        );
        if (promocoes.length) {
          html += carrosselHTML('Promoções', 'Aproveite enquanto dura', withBase('/catalogo#promocoes'), promocoes);
        }
        cont.innerHTML = html;

        // Liga as setas de cada carrossel a sua trilha.
        cont.querySelectorAll<HTMLElement>('.carrossel-track').forEach((track) => {
          const sec = track.closest('section');
          const passo = () => track.clientWidth * 0.8;
          sec?.querySelector('.carrossel-next')?.addEventListener('click', () =>
            track.scrollBy({ left: passo(), behavior: 'smooth' }),
          );
          sec?.querySelector('.carrossel-prev')?.addEventListener('click', () =>
            track.scrollBy({ left: -passo(), behavior: 'smooth' }),
          );
        });
      })
      .catch((e) => {
        console.error('[home] erro ao carregar produtos:', e);
        carregando?.classList.add('hidden');
        vazio?.classList.remove('hidden');
      });
  </script>
</BaseLayout>
