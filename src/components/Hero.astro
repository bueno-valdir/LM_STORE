---
/**
 * Banner principal (hero) em carrossel.
 * - Sem banners no painel: mostra os slides de texto de site.heroSlides.
 * - Com banners cadastrados (colecao "banners"): mostra as imagens, em ordem.
 */
import { site } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
import { withBase } from '../lib/url';

const slides = site.heroSlides;
---

<section class="relative overflow-hidden bg-fundo">
  <div
    class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-gradiente-marca opacity-20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-loja py-10 md:py-16">
    <div class="relative">
      <!-- Slides (texto por padrao; trocados por imagens se houver banners). -->
      <div id="hero-slides">
        {
          slides.map((slide, i) => (
            <div class:list={['hero-slide', { hidden: i !== 0 }]} data-slide={i}>
              <div class="mx-auto max-w-2xl text-center">
                <span class="etiqueta bg-marca/10 text-marca-escuro">{slide.etiqueta}</span>
                <h1 class="mt-4 font-titulo text-4xl font-bold leading-tight text-texto sm:text-5xl">
                  {slide.titulo}{' '}
                  <span class="bg-gradiente-marca bg-clip-text text-transparent">{slide.destaque}</span>
                </h1>
                <p class="mx-auto mt-4 max-w-lg text-texto-suave">{slide.texto}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- CTAs fixos. -->
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={withBase('/catalogo')} class="btn-marca">Ver catálogo</a>
        <WhatsAppButton variante="contorno" rotulo="Falar no WhatsApp" />
      </div>

      <!-- Bolinhas de navegacao. -->
      <div id="hero-dots" class="mt-8 flex justify-center gap-2">
        {
          slides.length > 1 &&
            slides.map((_, i) => (
              <button
                type="button"
                class="hero-dot h-2.5 w-2.5 rounded-full bg-fundo-borda aria-[current=true]:w-6 aria-[current=true]:bg-marca"
                data-dot={i}
                aria-current={i === 0 ? 'true' : 'false'}
                aria-label={`Ir para o slide ${i + 1}`}
              />
            ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { carregarBanners } from '../lib/clienteConteudo';
  import { esc } from '../lib/clienteProdutos';

  const elSlides = document.getElementById('hero-slides')!;
  const elDots = document.getElementById('hero-dots')!;
  let atual = 0;
  let timer: number | undefined;

  // (Re)liga o carrossel com os slides/bolinhas atuais.
  function wire() {
    const slides = Array.from(elSlides.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(elDots.querySelectorAll<HTMLButtonElement>('.hero-dot'));
    atual = 0;
    window.clearInterval(timer);

    function mostrar(i: number) {
      atual = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.classList.toggle('hidden', idx !== atual));
      dots.forEach((d, idx) => d.setAttribute('aria-current', idx === atual ? 'true' : 'false'));
    }
    if (slides.length > 1) {
      timer = window.setInterval(() => mostrar(atual + 1), 6000);
    }
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        mostrar(Number(dot.dataset.dot));
        window.clearInterval(timer);
        if (slides.length > 1) timer = window.setInterval(() => mostrar(atual + 1), 6000);
      });
    });
  }

  wire(); // slides de texto (padrao)

  // Se houver banners no painel, troca os slides de texto por imagens.
  carregarBanners()
    .then((banners) => {
      if (!banners.length) return;

      elSlides.innerHTML = banners
        .map((b, i) => {
          const img = `<img src="${esc(b.imagem)}" alt="${esc(b.titulo || 'Banner')}" class="w-full rounded-marca object-cover" />`;
          const conteudo = b.link ? `<a href="${esc(b.link)}">${img}</a>` : img;
          return `<div class="hero-slide${i !== 0 ? ' hidden' : ''}" data-slide="${i}">${conteudo}</div>`;
        })
        .join('');

      elDots.innerHTML =
        banners.length > 1
          ? banners
              .map(
                (_, i) =>
                  `<button type="button" class="hero-dot h-2.5 w-2.5 rounded-full bg-fundo-borda aria-[current=true]:w-6 aria-[current=true]:bg-marca" data-dot="${i}" aria-current="${i === 0 ? 'true' : 'false'}" aria-label="Ir para o banner ${i + 1}"></button>`,
              )
              .join('')
          : '';

      wire();
    })
    .catch(() => {});
</script>
