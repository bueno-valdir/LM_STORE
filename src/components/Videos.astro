---
/**
 * Secao de Videos (YouTube / Instagram). Comeca escondida e so aparece se o
 * painel tiver pelo menos um video ativo. Os videos sao lidos pelo navegador.
 */
---

<section id="vid-sec" class="hidden container-loja py-12">
  <div class="mb-6 text-center">
    <h2 class="font-titulo text-2xl font-bold text-texto">Vídeos</h2>
    <p class="mt-1 text-texto-suave">Dicas, novidades e bastidores da lojinha</p>
  </div>
  <div id="vid-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
</section>

<script>
  import { carregarVideos } from '../lib/clienteVideos';

  // Escapa texto para uso seguro em HTML.
  function esc(s: string): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  const sec = document.getElementById('vid-sec');
  const grid = document.getElementById('vid-grid');

  carregarVideos(12)
    .then((vids) => {
      if (!grid || !vids.length) return;
      grid.innerHTML = vids
        .map(
          (v) => `
          <figure class="overflow-hidden rounded-marca border border-fundo-borda bg-fundo-claro">
            <div class="aspect-video">
              <iframe
                src="${esc(v.embedUrl)}"
                title="${esc(v.titulo || 'Vídeo da Lojinha da Miih')}"
                loading="lazy"
                class="h-full w-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            ${v.titulo ? `<figcaption class="p-3 text-sm text-texto-suave">${esc(v.titulo)}</figcaption>` : ''}
          </figure>`,
        )
        .join('');
      sec?.classList.remove('hidden');
    })
    .catch((e) => console.error('[videos] erro ao carregar:', e));
</script>
