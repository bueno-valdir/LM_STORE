---
/**
 * Cabecalho: logo, busca e navegacao com mega-menu de categorias.
 * Preto com texto branco e acentos em rosa. Responsivo (menu no celular).
 *
 * As categorias/subcategorias vem da arvore fixa em src/config/categorias.ts
 * (mesma estrutura pedida pela cliente). "Marcas" e preenchida pelo navegador
 * a partir das marcas dos produtos cadastrados no painel.
 */
import Logo from './Logo.astro';
import { withBase } from '../lib/url';
import { arvoreCategorias } from '../config/categorias';

const linksNav = [
  { href: '/', rotulo: 'Início' },
  { href: '/catalogo', rotulo: 'Catálogo' },
  { href: '/catalogo#promocoes', rotulo: 'Promoções' },
  { href: '/entregas-e-pagamento', rotulo: 'Entregas' },
  { href: '/sobre', rotulo: 'Sobre' },
];
const acaoBusca = withBase('/catalogo');
const catalogo = withBase('/catalogo');
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-preto text-white">
  <!-- Linha principal: logo + busca + menu mobile. -->
  <div class="container-loja flex items-center gap-3 py-3">
    <a href={withBase('/')} class="shrink-0">
      <Logo />
    </a>

    <!-- Busca (desktop). -->
    <form action={acaoBusca} method="get" role="search" class="hidden flex-1 md:block">
      <div class="relative mx-auto max-w-xl">
        <input
          type="search"
          name="q"
          placeholder="O que você está procurando?"
          aria-label="Buscar produtos"
          class="w-full rounded-full border border-white/15 bg-white/5 px-4 py-2 pr-10 text-sm text-white placeholder:text-white/50 focus-visible:border-marca"
        />
        <button
          type="submit"
          aria-label="Buscar"
          class="absolute right-1 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-full text-white/70 hover:text-marca-claro"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.3-4.3" />
          </svg>
        </button>
      </div>
    </form>

    <!-- Menu no celular. -->
    <details class="relative ml-auto md:hidden">
      <summary
        class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-marca border border-white/20 text-white"
        aria-label="Abrir menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 max-h-[80vh] w-72 overflow-y-auto rounded-marca border border-white/10 bg-preto-claro p-3 shadow-marca">
        <form action={acaoBusca} method="get" role="search" class="mb-2">
          <input
            type="search"
            name="q"
            placeholder="Buscar..."
            aria-label="Buscar produtos"
            class="w-full rounded-full border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/50 focus-visible:border-marca"
          />
        </form>
        <nav aria-label="Navegação">
          {
            linksNav.map((link) => (
              <a
                href={withBase(link.href)}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-marca-claro"
              >
                {link.rotulo}
              </a>
            ))
          }

          <!-- Categorias (cada uma abre suas subcategorias). -->
          <p class="mt-2 px-3 pb-1 pt-2 text-[10px] uppercase tracking-wide text-white/40">Categorias</p>
          {
            arvoreCategorias.map((cat) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-marca-claro">
                  {cat.rotulo}
                  <svg class="transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </summary>
                <div class="ml-2 border-l border-white/10 pl-2">
                  <a href={`${catalogo}?cat=${cat.slug}`} class="block rounded-lg px-3 py-1.5 text-xs text-marca-claro hover:bg-white/10">
                    Ver tudo em {cat.rotulo}
                  </a>
                  {cat.subs.map((sub) => (
                    <a href={`${catalogo}?sub=${sub.slug}`} class="block rounded-lg px-3 py-1.5 text-xs text-white/70 hover:bg-white/10 hover:text-marca-claro">
                      {sub.rotulo}
                    </a>
                  ))}
                </div>
              </details>
            ))
          }

          <!-- Marcas (preenchido pelo navegador). -->
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-marca-claro">
              Marcas
              <svg class="transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <div id="marcas-mobile" class="ml-2 border-l border-white/10 pl-2">
              <p class="px-3 py-1.5 text-xs text-white/50">Carregando...</p>
            </div>
          </details>
        </nav>
      </div>
    </details>
  </div>

  <!-- Linha de navegacao (desktop) com mega-menu. -->
  <nav class="hidden border-t border-white/10 md:block" aria-label="Navegação principal">
    <div class="container-loja flex items-center gap-1 py-1 text-sm">
      <!-- Todas as Categorias (mega-menu com tudo). -->
      <div class="menu-item group relative">
        <a href={catalogo} class="flex items-center gap-1 rounded-lg px-3 py-2 font-medium text-white/90 hover:bg-white/10 hover:text-marca-claro">
          Todas as Categorias
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </a>
        <div class="menu-painel invisible absolute left-0 top-full z-50 w-[min(56rem,90vw)] rounded-marca border border-white/10 bg-preto-claro p-5 opacity-0 shadow-marca transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-4">
            {
              arvoreCategorias.map((cat) => (
                <div>
                  <a href={`${catalogo}?cat=${cat.slug}`} class="block font-titulo text-sm font-semibold text-marca-claro hover:underline">
                    {cat.rotulo}
                  </a>
                  <ul class="mt-1.5 space-y-1">
                    {cat.subs.map((sub) => (
                      <li>
                        <a href={`${catalogo}?sub=${sub.slug}`} class="block text-xs text-white/70 transition-colors hover:text-marca-claro">
                          {sub.rotulo}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Marcas (preenchido pelo navegador). -->
      <div class="menu-item group relative">
        <button type="button" class="flex items-center gap-1 rounded-lg px-3 py-2 font-medium text-white/90 hover:bg-white/10 hover:text-marca-claro">
          Marcas
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div id="marcas-desktop" class="menu-painel invisible absolute left-0 top-full z-50 max-h-96 w-64 overflow-y-auto rounded-marca border border-white/10 bg-preto-claro p-3 opacity-0 shadow-marca transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <p class="px-2 py-1 text-xs text-white/50">Carregando...</p>
        </div>
      </div>

      <!-- Uma entrada por categoria-mae, com suas subcategorias. -->
      {
        arvoreCategorias.map((cat) => (
          <div class="menu-item group relative">
            <a href={`${catalogo}?cat=${cat.slug}`} class="flex items-center gap-1 whitespace-nowrap rounded-lg px-3 py-2 font-medium text-white/80 hover:bg-white/10 hover:text-marca-claro">
              {cat.rotulo}
            </a>
            <div class="menu-painel invisible absolute left-0 top-full z-50 w-60 rounded-marca border border-white/10 bg-preto-claro p-2 opacity-0 shadow-marca transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <a href={`${catalogo}?cat=${cat.slug}`} class="block rounded-lg px-3 py-1.5 text-xs font-semibold text-marca-claro hover:bg-white/10">
                Ver tudo
              </a>
              {cat.subs.map((sub) => (
                <a href={`${catalogo}?sub=${sub.slug}`} class="block rounded-lg px-3 py-1.5 text-sm text-white/80 transition-colors hover:bg-white/10 hover:text-marca-claro">
                  {sub.rotulo}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <a href={`${catalogo}#promocoes`} class="ml-auto whitespace-nowrap rounded-lg px-3 py-2 font-medium text-marca-claro hover:bg-white/10">
        Promoção
      </a>
    </div>
  </nav>
</header>

<script>
  import { carregarProdutos, esc } from '../lib/clienteProdutos';
  import { withBase } from '../lib/url';

  // Preenche os menus de Marcas (desktop e mobile) com as marcas reais dos produtos.
  const alvos = [
    document.getElementById('marcas-desktop'),
    document.getElementById('marcas-mobile'),
  ].filter(Boolean) as HTMLElement[];

  if (alvos.length) {
    carregarProdutos()
      .then((produtos) => {
        const marcas = Array.from(
          new Set(produtos.map((p) => (p.marca || '').trim()).filter(Boolean)),
        ).sort((a, b) => a.localeCompare(b, 'pt-BR'));

        if (!marcas.length) {
          alvos.forEach((el) => {
            el.innerHTML = '<p class="px-3 py-1.5 text-xs text-white/50">Em breve</p>';
          });
          return;
        }

        const html = marcas
          .map(
            (m) =>
              `<a href="${withBase('/catalogo')}?marca=${encodeURIComponent(m)}" class="block rounded-lg px-3 py-1.5 text-sm text-white/80 transition-colors hover:bg-white/10 hover:text-marca-claro">${esc(m)}</a>`,
          )
          .join('');
        alvos.forEach((el) => {
          el.innerHTML = html;
        });
      })
      .catch(() => {
        alvos.forEach((el) => {
          el.innerHTML = '<p class="px-3 py-1.5 text-xs text-white/50">Indisponível</p>';
        });
      });
  }
</script>
