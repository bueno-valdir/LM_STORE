---
/**
 * Logo da marca.
 *
 * Mostra um placeholder (anel com "M") e, se houver uma logo cadastrada no
 * painel (colecao "configuracao", campo "logo"), troca pela imagem real.
 * Aparece sobre fundo escuro (header e footer).
 */
import { site } from '../config/site';
---

<span class="logo-marca inline-flex items-center gap-2" aria-label={site.nome}>
  <!-- Placeholder (trocado pela logo real, se houver). -->
  <span
    class="grid h-9 w-9 place-items-center rounded-full bg-gradiente-marca text-white"
    aria-hidden="true"
  >
    <span class="grid h-7 w-7 place-items-center rounded-full bg-preto font-manuscrita text-base text-marca-claro">
      M
    </span>
  </span>
  <span class="font-manuscrita text-xl leading-none text-white">{site.nome}</span>
</span>

<script>
  import { carregarConfig } from '../lib/clienteConteudo';

  carregarConfig().then((cfg) => {
    if (!cfg.logoUrl) return;
    const img = `<img src="${cfg.logoUrl}" alt="Lojinha da Miih" class="h-9 w-auto" />`;
    document.querySelectorAll('.logo-marca').forEach((el) => {
      el.innerHTML = img;
    });
  });
</script>
